PORT=3000
NODE_ENV=production

# Supabase PostgreSQL
SUPABASE_URL=https://gwhzvstdopxvogsdfmmg.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
DATABASE_URL=postgresql://postgres:rft-entertainment7009@db.gwhzvstdopxvogsdfmmg.supabase.co:5432/postgres

# JWT — CHANGE THIS to a long random string in production
JWT_SECRET=change-this-to-a-very-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS — your Netlify frontend URL
CORS_ORIGIN=https://rft-frontend.netlify.app

# Frontend URL (used in referral links)
FRONTEND_URL=https://rft-frontend.netlify.app

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Business Rules
PKR_RATE=280
DAILY_TASK_LIMIT=10
TASK_REWARD_USDT=0.1
MIN_RECHARGE_USDT=10
MAX_RECHARGE_USDT=10000
MIN_WITHDRAW_USDT=10
MAX_WITHDRAW_USDT=10000

# WhatsApp Support Number (international format, no +)
SUPPORT_WHATSAPP=923XXXXXXXXX

# Password Reset OTP Delivery
# ── Option 1: Email via Resend (recommended, free 3000 emails/month)
# Get free API key at: https://resend.com/signup
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=RFT Entertainment <noreply@yourdomain.com>

# ── Option 2: SMS via Twilio (~$0.0075 per SMS to Pakistan)
# Get credentials at: https://twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+12015550123

# ── If NEITHER is configured:
# OTP is stored in Supabase password_resets table
# Admin can read it: SELECT otp, expires_at FROM password_resets ORDER BY created_at DESC LIMIT 5;
# In dev mode (NODE_ENV != production) OTP is also returned in the API response
